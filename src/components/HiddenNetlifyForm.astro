<form
  name="newsletter-subscribe"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  hidden
  aria-hidden="true"
>
  <input type="hidden" name="form-name" value="newsletter-subscribe" />
  <input type="email" name="email" />
  <input type="text" name="formLocation" />
  <input type="text" name="submittedAt" />
  <input type="text" name="path" />
  <input type="text" name="utm_source" />
  <input type="text" name="utm_medium" />
  <input type="text" name="utm_campaign" />
  <input type="text" name="utm_content" />
  <input type="text" name="utm_term" />
  <input type="text" name="bot-field" />
</form>
