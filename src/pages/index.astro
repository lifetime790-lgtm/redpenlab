---
import SubscribeForm from "../components/SubscribeForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  audience,
  brand,
  categories,
  faq,
  finalCta,
  formCopy,
  hero,
  intro,
  issueStructure,
  samples,
  siteMeta,
} from "../data/landingCopy";

const pageTitle = `${siteMeta.title} | ${brand.studio}`;
const panelLabels = [
  "Hero",
  intro.eyebrow,
  ...categories.map((item) => item.title),
  issueStructure.eyebrow,
  ...samples.map((sample) => sample.title),
  audience.eyebrow,
  "FAQ",
  "구독",
];
const totalPanels = String(panelLabels.length).padStart(2, "0");
const topicNotes = [
  {
    headline: "익숙한 이름보다 실제 조건을 먼저 씁니다.",
    body: "무엇이 들어갔는가보다, 얼마나 들어갔고 어떤 형태인지부터 다시 읽습니다.",
  },
  {
    headline: "상식이 굳어지는 순간을 거꾸로 추적합니다.",
    body: "너무 자연스러워서 질문조차 사라진 문장을, 언제부터 당연해졌는지부터 다시 봅니다.",
  },
  {
    headline: "숫자가 주는 안심의 구조를 읽어냅니다.",
    body: "0, 하루치, 고단백 같은 표현이 정보보다 인상을 먼저 만드는 방식을 차분히 분해합니다.",
  },
  {
    headline: "좋아 보이는 문장 뒤의 감정을 건드립니다.",
    body: "설명보다 안심을 먼저 파는 문장이 어떤 불안과 욕망을 움직이는지 차근히 뜯어봅니다.",
  },
  {
    headline: "비교는 늘 조건 위에서 다시 판정합니다.",
    body: "A와 B 중 무엇이 낫냐는 질문을, 누구에게 어떤 상황인지까지 포함해 다시 묻습니다.",
  },
];
---

<BaseLayout title={pageTitle} description={siteMeta.description} path="/">
  <main class="snap-shell" data-slide-shell>
    <div class="site-mark" aria-hidden="true">
      <span>{brand.studio}</span>
      <span>{brand.newsletter}</span>
    </div>

    <aside class="slide-progress" aria-hidden="true">
      <p class="slide-progress__count">
        <span data-current-panel>01</span>
        <span>/</span>
        <span data-total-panels>{totalPanels}</span>
      </p>
      <p class="slide-progress__label" data-current-label>{panelLabels[0]}</p>
      <div class="slide-progress__dots">
        {panelLabels.map((label, index) => (
          <button
            type="button"
            class="slide-progress__dot"
            data-progress-dot
            data-progress-index={index}
            data-progress-label={label}
            aria-label={`${label} 섹션으로 이동`}
          />
        ))}
      </div>
    </aside>

    <section class="slide slide--hero" data-panel data-panel-label="Hero" id="top">
      <div class="container slide__inner hero-layout">
        <div class="hero-copy">
          <p class="kicker">{hero.eyebrow}</p>
          <h1 class="hero-display">
            <span>건강시장의 말을</span>
            <span>해부하는 뉴스레터</span>
          </h1>
          <p class="section-lead hero-lead">{hero.subcopy}</p>

          <div class="sheet hero-sheet">
            <SubscribeForm
              location="hero"
              placeholder={formCopy.placeholder}
              ctaLabel={hero.cta}
              note={hero.note}
            />
          </div>
        </div>

        <aside class="sheet dossier">
          <p class="sheet-rubric">Editorial dossier</p>
          <div class="dossier__brand">
            <span>{brand.studio}</span>
            <strong>{brand.newsletter}</strong>
          </div>
          <p class="dossier__message">{brand.message}</p>
          <ul class="dossier__list">
            <li>성분, 라벨, 광고 문구를 차분하게 판독합니다.</li>
            <li>질문을 던지고, 근거와 기준으로 본편을 보냅니다.</li>
            <li>평일마다 Mini 또는 Full 형식으로 도착합니다.</li>
          </ul>
        </aside>
      </div>

      <p class="slide-hint" aria-hidden="true">Scroll to continue</p>
    </section>

    <section class="slide" data-panel data-panel-label={intro.eyebrow}>
      <div class="container slide__inner intro-layout">
        <div class="section-copy">
          <p class="kicker">{intro.eyebrow}</p>
          <h2 class="section-title">{intro.title}</h2>
          <p class="section-lead">{intro.description}</p>
        </div>

        <div class="comparison-grid">
          {intro.cards.map((card, index) => (
            <article class:list={["sheet", "comparison-card", index === 1 && "comparison-card--accent"]}>
              <p class="comparison-card__label">{card.label}</p>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {categories.map((item, index) => (
      <section
        class:list={["slide", "slide--topic", index % 2 === 1 && "slide--topic-alt"]}
        data-panel
        data-panel-label={item.title}
      >
        <div class="container slide__inner topic-layout">
          <div class="topic-copy">
            <p class="topic-count">0{index + 1}</p>
            <p class="kicker">무엇을 다루는지</p>
            <h2 class="section-title topic-title">{item.title}</h2>
            <p class="section-lead">{item.description}</p>
          </div>

          <article class="sheet topic-note">
            <p class="topic-note__label">읽는 기준</p>
            <h3>{topicNotes[index].headline}</h3>
            <p>{topicNotes[index].body}</p>
          </article>
        </div>
      </section>
    ))}

    <section class="slide" data-panel data-panel-label={issueStructure.eyebrow}>
      <div class="container slide__inner cadence-layout">
        <div class="section-copy">
          <p class="kicker">{issueStructure.eyebrow}</p>
          <h2 class="section-title">{issueStructure.title}</h2>
          <p class="section-lead">{issueStructure.description}</p>

          <div class="sheet sheet--accent cadence-lines">
            {issueStructure.lines.map((line) => (
              <p>{line}</p>
            ))}
          </div>
        </div>

        <div class="mode-stack">
          {issueStructure.modes.map((mode) => (
            <article class="sheet mode-card">
              <p class="comparison-card__label">{mode.label}</p>
              <h3>{mode.title}</h3>
              <p>{mode.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {samples.map((sample, index) => (
      <section
        class:list={["slide", "slide--sample", index === 1 && "slide--sample-alt"]}
        data-panel
        data-panel-label={sample.title}
      >
        <div class="container slide__inner sample-layout">
          <div class="section-copy sample-copy">
            <p class="kicker">샘플 미리보기</p>
            <h2 class="section-title">{sample.title}</h2>
            <p class="section-lead">{sample.category}</p>
          </div>

          <article class="sheet letter-card">
            <header class="letter-card__header">
              <span>{brand.studio}</span>
              <span>{sample.category}</span>
            </header>
            <div class="letter-card__body">
              {sample.preview.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <footer class="letter-card__footer">
              <span>{brand.newsletter}</span>
              <span>Preview 0{index + 1}</span>
            </footer>
          </article>
        </div>
      </section>
    ))}

    <section class="slide" data-panel data-panel-label={audience.eyebrow}>
      <div class="container slide__inner audience-layout">
        <div class="section-copy">
          <p class="kicker">{audience.eyebrow}</p>
          <h2 class="section-title">{audience.title}</h2>
        </div>

        <div class="sheet audience-sheet">
          {audience.items.map((item, index) => (
            <article class="audience-point">
              <span>0{index + 1}</span>
              <p>{item}</p>
            </article>
          ))}
          <p class="audience-closing">{audience.closing}</p>
        </div>
      </div>
    </section>

    <section class="slide" data-panel data-panel-label="FAQ">
      <div class="container slide__inner faq-layout">
        <div class="section-copy">
          <p class="kicker">FAQ</p>
          <h2 class="section-title">자주 받게 될 질문을 먼저 답합니다.</h2>
        </div>

        <div class="faq-grid">
          {faq.map((item) => (
            <article class="sheet faq-card">
              <p class="faq-card__question">{item.question}</p>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="slide slide--cta" data-panel data-panel-label="구독" id="subscribe">
      <div class="container slide__inner cta-layout">
        <div class="sheet cta-sheet">
          <p class="kicker">{finalCta.eyebrow}</p>
          <h2 class="section-title">{finalCta.title}</h2>
          <p class="section-lead">{finalCta.description}</p>

          <SubscribeForm
            location="footer"
            placeholder={formCopy.placeholder}
            ctaLabel={hero.cta}
            note={hero.note}
          />

          <div class="cta-sheet__footer">
            <span>{brand.studio}</span>
            <span>{brand.newsletter}</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { setupLandingPage } from "../scripts/landing";

    setupLandingPage();
  </script>
</BaseLayout>
