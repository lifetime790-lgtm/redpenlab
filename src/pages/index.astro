---
import SubscribeForm from "../components/SubscribeForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  brand,
  categories,
  finalCta,
  formCopy,
  hero,
  intro,
  issueStructure,
  samples,
  siteMeta,
} from "../data/landingCopy";

const pageTitle = `${siteMeta.title} | ${brand.studio}`;
const primarySample = samples[0];
const topicNotes = [
  {
    headline: "익숙한 이름보다 실제 조건을 먼저 씁니다.",
    body: "무엇이 들어갔는가보다, 얼마나 들어갔고 어떤 형태인지부터 다시 읽습니다.",
  },
  {
    headline: "상식이 굳어지는 순간을 거꾸로 추적합니다.",
    body: "너무 자연스러워서 질문조차 사라진 문장을, 언제부터 당연해졌는지부터 다시 봅니다.",
  },
  {
    headline: "숫자가 주는 안심의 구조를 읽어냅니다.",
    body: "0, 하루치, 고단백 같은 표현이 정보보다 인상을 먼저 만드는 방식을 차분히 분해합니다.",
  },
  {
    headline: "좋아 보이는 문장 뒤의 감정을 건드립니다.",
    body: "설명보다 안심을 먼저 파는 문장이 어떤 불안과 욕망을 움직이는지 차근히 뜯어봅니다.",
  },
  {
    headline: "비교는 늘 조건 위에서 다시 판정합니다.",
    body: "A와 B 중 무엇이 낫냐는 질문을, 누구에게 어떤 상황인지까지 포함해 다시 묻습니다.",
  },
];
---

<BaseLayout title={pageTitle} description={siteMeta.description} path="/">
  <main class="snap-shell" data-slide-shell>
    <section class="slide" data-panel data-panel-label="Hero" id="top">
      <div class="container slide__inner">
        <article class="page-sheet page-sheet--hero">
          <div class="hero-layout">
            <div class="hero-copy">
              <p class="kicker">{hero.eyebrow}</p>
              <h1 class="hero-display">
                건강시장의 말을
                <br />
                해부하는 뉴스레터
              </h1>
              <p class="section-lead hero-lead">{hero.subcopy}</p>
              <p class="hero-topics">{hero.topics.join(" · ")}</p>
              <p class="page-footnote">{hero.note}</p>
            </div>

            <div class="hero-pane">
              <div class="mark-card">
                <img src="/redpen-mark.svg" alt="" class="brand-mark" width="104" height="104" />
                <div class="editor-note">
                  <p class="editor-note__label">Red Pen Mark</p>
                  <p class="editor-note__brand">{brand.newsletter}</p>
                  <p class="editor-note__text">{brand.message}</p>
                </div>
              </div>

              <div class="form-frame">
                <SubscribeForm
                  location="hero"
                  nicknamePlaceholder={formCopy.nicknamePlaceholder}
                  placeholder={formCopy.placeholder}
                  ctaLabel={hero.cta}
                  note={formCopy.nicknameNote}
                />
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="slide" data-panel data-panel-label={intro.eyebrow}>
      <div class="container slide__inner">
        <article class="page-sheet page-sheet--intro">
          <div class="intro-layout">
            <div class="intro-copy">
              <p class="kicker">{intro.eyebrow}</p>
              <h2 class="section-title">
                질문은 피드에,
                <br />
                기준은 메일에 남깁니다.
              </h2>
              <p class="section-lead">{intro.description}</p>
            </div>

            <div class="intro-panels">
              {intro.cards.map((card) => (
                <article class="story-item">
                  <p class="story-item__label">{card.label}</p>
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="intro-cadence">
            <p class="intro-cadence__lead">평일마다 Mini 또는 Full로 도착합니다.</p>
            <div class="intro-cadence__modes">
              {issueStructure.modes.map((mode) => (
                <span>{mode.label} · {mode.title}</span>
              ))}
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="slide" data-panel data-panel-label="카테고리">
      <div class="container slide__inner">
        <article class="page-sheet page-sheet--topics">
          <div class="topics-head">
            <div class="topics-copy">
              <p class="kicker">무엇을 다루는지</p>
              <h2 class="section-title">
                한 장씩 넘기면
                <br />
                기준이 보입니다.
              </h2>
              <p class="section-lead">
                다섯 가지 주제를 한 번에 설명하지 않고, 한 장씩 넘기며 읽는 구조로 정리했습니다.
              </p>
            </div>

            <div class="topics-status" aria-hidden="true">
              <span data-topic-current>01</span>
              <span>/</span>
              <span>05</span>
            </div>
          </div>

          <div class="topics-viewport">
            <div class="topics-carousel" data-topic-carousel tabindex="0" aria-label="뉴스레터 카테고리">
              {categories.map((item, index) => (
                <article class="topic-card" data-topic-card>
                  <div class="topic-card__number">0{index + 1}</div>
                  <div class="topic-card__content">
                    <p class="topic-card__kicker">Category</p>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                  <div class="topic-card__aside">
                    <p class="topic-card__label">읽는 기준</p>
                    <p class="topic-card__headline">{topicNotes[index].headline}</p>
                    <p class="topic-card__body">{topicNotes[index].body}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="topics-footer">
            <div class="topics-dots" aria-label="카테고리 슬라이드 이동">
              {categories.map((item, index) => (
                <button
                  type="button"
                  class="topics-dot"
                  data-topic-dot
                  data-topic-index={index}
                  aria-label={`${item.title} 보기`}
                />
              ))}
            </div>

            <div class="topics-nav">
              <button type="button" class="topics-nav__button" data-topic-prev aria-label="이전 카테고리">
                Prev
              </button>
              <button type="button" class="topics-nav__button" data-topic-next aria-label="다음 카테고리">
                Next
              </button>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="slide" data-panel data-panel-label="샘플">
      <div class="container slide__inner">
        <article class="page-sheet page-sheet--sample">
          <div class="sample-layout">
            <div class="sample-copy">
              <p class="kicker">샘플 미리보기</p>
              <h2 class="section-title">
                실제 메일은
                <br />
                이런 톤으로 옵니다.
              </h2>
              <p class="section-lead">
                문장을 길게 포장하기보다, 표현 하나를 다시 보게 만드는 방식으로 씁니다.
              </p>
            </div>

            <div class="sample-sheet">
              <div class="sample-meta">
                <span>{primarySample.category}</span>
                <span>Preview 01</span>
              </div>
              <h2 class="section-title">{primarySample.title}</h2>
              <div class="sample-body">
                {primarySample.preview.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              <p class="sample-signoff">{brand.newsletter} preview</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="slide" data-panel data-panel-label="구독" id="subscribe">
      <div class="container slide__inner">
        <article class="page-sheet page-sheet--cta">
          <div class="cta-layout">
            <div class="cta-copy">
              <div class="cta-markline">
                <img src="/redpen-mark.svg" alt="" class="cta-mark" width="72" height="72" />
                <p class="kicker">{finalCta.eyebrow}</p>
              </div>
              <h2 class="section-title">{finalCta.title}</h2>
              <p class="section-lead">{finalCta.description}</p>
              <p class="page-signoff">{brand.studio} · {brand.newsletter}</p>
            </div>

            <div class="form-frame form-frame--cta">
              <SubscribeForm
                location="footer"
                nicknamePlaceholder={formCopy.nicknamePlaceholder}
                placeholder={formCopy.placeholder}
                ctaLabel={hero.cta}
                note={formCopy.nicknameNote}
              />
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>

  <script>
    import { setupLandingPage } from "../scripts/landing";

    setupLandingPage();
  </script>
</BaseLayout>
